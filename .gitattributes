# Line endings are pinned deliberately.
#
# This project is authored on Windows and compiled on macOS (GitHub Actions).
# Windows machines frequently have core.autocrlf=true, which would otherwise
# let CRLF leak into files that the macOS toolchain reads literally - most
# dangerously .xcconfig (Xcode's #include parser), Podfile (Ruby) and
# build_ios.sh (a /bin/sh script, where "#!/bin/sh\r" is a hard failure).
#
# Normalise every text file to LF in the repository *and* in the working tree,
# on every platform. Both Xcode and Flutter are happy with LF on Windows.
* text=auto eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.ipa  binary
*.jar  binary

# Git's own bookkeeping.
.gitattributes text eol=lf
